{
  "name": "bhashalens",
  "private": true,
  "version": "0.1.0",
  "description": "Rekhta-inspired inline dictionary platform for Bengali.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "seed": "pnpm --filter @bhashalens/api seed",
    "seed:all": "pnpm --filter @bhashalens/api seed:all",
    "ext:build": "pnpm --filter @bhashalens/extension build:all",
    "ext:package": "pnpm --filter @bhashalens/extension package:all",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
